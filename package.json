{
  "name": "@cloady/mcp",
  "version": "0.5.1",
  "description": "Local MCP server for Cloady, generated from its OpenAPI contract: every API operation as a tool.",
  "type": "module",
  "main": "build/index.js",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && shx chmod 755 build/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "json-schema-to-zod": "^2.6.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "shx": "^0.4.0",
    "typescript": "^5.8.3"
  },
  "mcpName": "com.cloady/mcp",
  "license": "MIT",
  "homepage": "https://cloady.com",
  "author": "NeptoLab <hello@cloady.com>",
  "bin": {
    "cloady-mcp": "build/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cloady",
    "mcp",
    "model-context-protocol",
    "ai",
    "deploy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cloady/cloady-mcp.git"
  }
}
